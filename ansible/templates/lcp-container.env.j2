{% set env = item.value.env | default({}) %}
LSD_BASE_URL={{ env.LSD_BASE_URL | default('https://' ~ item.value.domain ~ '/lsdserver') }}
LCP_BASE_URL={{ env.LCP_BASE_URL | default('https://' ~ item.value.domain ~ '/lcpserver') }}
FRONTEND_BASE_URL={{ env.FRONTEND_BASE_URL | default('https://' ~ item.value.domain ~ '/frontend') }}
FRONTEND_PROVIDER_URI={{ env.FRONTEND_PROVIDER_URI | default('https://' ~ item.value.domain) }}
BASE_URL={{ env.BASE_URL | default('https://' ~ item.value.domain ~ '/frontend/') }}
STORAGE_BASE_URL={{ env.STORAGE_BASE_URL | default('https://' ~ item.value.domain ~ '/storage') }}
{% for name, value in env.items() %}
{% if name not in ['LSD_BASE_URL', 'LCP_BASE_URL', 'FRONTEND_BASE_URL', 'FRONTEND_PROVIDER_URI', 'BASE_URL', 'STORAGE_BASE_URL'] %}
{{ name }}={{ value }}
{% endif %}
{% endfor %}
